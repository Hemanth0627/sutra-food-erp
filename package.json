{
  "name": "sutra-food-erp",
  "version": "1.0.0",
  "private": true,
  "description": "Sutra ERP: food manufacturing ERP and production management prototype (sales, GST invoicing, BOM, production, inventory ledger, costing, receivables and audit reports).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:benchmark": "vitest run tests/integration",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "benchmark:reset": "prisma migrate reset --force",
    "benchmark:verify": "tsx scripts/verify-benchmark.ts",
    "setup": "prisma migrate deploy && prisma db seed",
    "postinstall": "prisma generate",
    "test:smoke": "node scripts/smoke-test.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "demo:fresh": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts --masters-only"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "decimal.js": "10.6.0",
    "exceljs": "4.4.0",
    "geist": "1.9.2",
    "gsap": "3.15.1",
    "lucide-react": "1.74.0",
    "next": "15.5.29",
    "next-themes": "0.4.6",
    "pdfkit": "0.20.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-is": "19.3.1",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "three": "0.187.0",
    "vanta": "0.5.24",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/pdfkit": "0.17.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
