# Copy to .env and fill in real values. .env is git-ignored; never commit it.

# ── PostgreSQL (used by docker-compose.yml) ──
POSTGRES_USER=sutra
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=sutra_erp
POSTGRES_PORT=5432

# ── Prisma connection strings ──
# Main application database
DATABASE_URL="postgresql://sutra:change-me-local-only@localhost:5432/sutra_erp?schema=public"
# Separate database used by the automated benchmark tests (it is reset on every test run)
TEST_DATABASE_URL="postgresql://sutra:change-me-local-only@localhost:5432/sutra_erp_test?schema=public"

# ── Auth ──
# Long random string used to HMAC session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-64-char-random-hex-string

# Password given to every seeded demo account (demo data only)
SEED_DEMO_PASSWORD=Demo@1234
