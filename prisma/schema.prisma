// Sutra ERP: food manufacturing ERP data model.
//
// Conventions
// - Money: Decimal(14,2) (rupees, 2 dp). Never floats.
// - Quantities: Decimal(14,3) in the item's stock unit.
// - Unit costs: Decimal(18,6) so weighted-average rates such as 43.125 stay exact.
// - Inventory value: Decimal(16,4).
// - Stock never changes except through an InventoryTransaction row. InventoryBalance is a
//   transactional cache that is updated in the same DB transaction as the ledger insert and
//   is reconciled against SUM(ledger) by the reconciliation report and the test suite.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Role {
  OWNER
  ADMIN
  SALESMAN
  PRODUCTION_SUPERVISOR
  ACCOUNTANT
}

enum UnitDimension {
  MASS
  VOLUME
  COUNT
}

enum ItemKind {
  RAW_MATERIAL
  PACKAGING_MATERIAL
  FINISHED_GOOD
}

enum CustomerType {
  RETAILER
  DISTRIBUTOR
}

enum MovementType {
  OPENING_STOCK
  PURCHASE_RECEIPT
  PRODUCTION_ISSUE
  PRODUCTION_OUTPUT
  SALES_DISPATCH
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  STOCK_ADJUSTMENT
  PACKAGING_CONSUMPTION
  DAMAGED_MATERIAL
}

enum SourceType {
  OPENING
  PURCHASE
  PURCHASE_RETURN
  PRODUCTION_RUN
  DISPATCH
  CREDIT_NOTE
  ADJUSTMENT
}

enum BomStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ExpenseCategory {
  LABOUR
  GAS
  ELECTRICITY
  GAS_AND_POWER
  OTHER_OVERHEAD
}

enum AllocationMethod {
  DIRECT
  OUTPUT_QUANTITY
}

enum OrderStatus {
  PENDING
  APPROVED
  PARTIALLY_FULFILLED
  FULFILLED
  REJECTED
  CANCELLED
}

enum InvoiceStatus {
  ISSUED
  CANCELLED
}

enum SupplyType {
  INTRA_STATE
  INTER_STATE
}

enum PurchaseOrderStatus {
  OPEN
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
}

// ─────────────────────────── Identity & config ───────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  phone        String?
  role         Role
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions          Session[]
  auditLogs         AuditLog[]
  ordersAsSalesman  SalesOrder[]           @relation("OrderSalesman")
  ordersApproved    SalesOrder[]           @relation("OrderApprover")
  assignedCustomers Customer[]             @relation("CustomerSalesman")
  inventoryTxns     InventoryTransaction[]
  purchases         Purchase[]
  productionRuns    ProductionRun[]        @relation("RunCreator")
  invoices          Invoice[]              @relation("InvoiceCreator")
  dispatches        Dispatch[]
  payments          Payment[]
  expenses          Expense[]
  bomVersions       BomVersion[]
  creditNotes       CreditNote[]
  adjustments       StockAdjustment[]
  purchaseReturns   PurchaseReturn[]
  purchaseOrders    PurchaseOrder[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Single-row company configuration (seller GST details, variance tolerance).
model CompanySettings {
  id                   Int      @id @default(1)
  legalName            String
  tradeName            String
  gstin                String
  pan                  String?
  addressLine1         String
  addressLine2         String?
  city                 String
  state                String
  stateCode            String   @db.VarChar(2)
  pincode              String
  phone                String?
  email                String?
  bankDetails          String?
  varianceTolerancePct Decimal  @default(3) @db.Decimal(5, 2)
  lowStockAlertEnabled Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

/// Concurrency-safe document numbering (row-locked inside the posting transaction).
model DocumentSequence {
  key       String @id
  lastValue Int    @default(0)
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  summary    String
  data       Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([userId])
}

// ─────────────────────────────── Masters ───────────────────────────────

model Unit {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String
  dimension UnitDimension
  /// Multiplier to the dimension's base unit (kg, litre, piece). g = 0.001, ml = 0.001.
  toBase    Decimal       @db.Decimal(18, 6)

  items              Item[]
  bomItems           BomItem[]
  purchaseItems      PurchaseItem[]
  purchaseOrderItems PurchaseOrderItem[]
}

model ProductCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  products    Product[]
}

/// Every stockable thing: raw materials, packaging materials and finished goods.
/// RawMaterial / PackagingMaterial are Items with the corresponding kind.
model Item {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  kind          ItemKind
  unitId        String
  reorderLevel  Decimal  @default(0) @db.Decimal(14, 3)
  description   String?
  shelfLifeDays Int?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  unit               Unit                   @relation(fields: [unitId], references: [id])
  product            Product?
  balance            InventoryBalance?
  ledger             InventoryTransaction[]
  bomItems           BomItem[]
  purchaseItems      PurchaseItem[]
  productionMaterial ProductionMaterial[]
  productionOutputs  ProductionOutput[]
  adjustments        StockAdjustment[]
  purchaseOrderItems PurchaseOrderItem[]

  @@index([kind])
}

/// Sales master for a finished good (1:1 with its stock Item).
model Product {
  id           String   @id @default(cuid())
  itemId       String   @unique
  sku          String   @unique
  categoryId   String
  packSize     String
  hsnCode      String
  gstRate      Decimal  @db.Decimal(5, 2)
  sellingPrice Decimal  @db.Decimal(12, 2)
  mrp          Decimal? @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  item           Item             @relation(fields: [itemId], references: [id])
  category       ProductCategory  @relation(fields: [categoryId], references: [id])
  boms           Bom[]
  productionRuns ProductionRun[]
  orderItems     SalesOrderItem[]
  invoiceItems   InvoiceItem[]
  dispatchItems  DispatchItem[]
}

model Customer {
  id               String       @id @default(cuid())
  code             String       @unique
  name             String
  type             CustomerType
  gstin            String?
  phone            String
  email            String?
  addressLine      String
  city             String
  state            String
  stateCode        String       @db.VarChar(2)
  pincode          String?
  placeOfSupply    String
  creditLimit      Decimal      @default(0) @db.Decimal(14, 2)
  paymentTermsDays Int          @default(30)
  salesmanId       String?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  salesman    User?        @relation("CustomerSalesman", fields: [salesmanId], references: [id])
  orders      SalesOrder[]
  invoices    Invoice[]
  payments    Payment[]
  dispatches  Dispatch[]
  creditNotes CreditNote[]

  @@index([type])
  @@index([salesmanId])
}

model Supplier {
  id               String          @id @default(cuid())
  code             String          @unique
  name             String
  gstin            String?
  phone            String
  email            String?
  addressLine      String
  city             String
  state            String
  stateCode        String          @db.VarChar(2)
  paymentTermsDays Int             @default(30)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  purchases        Purchase[]
  purchaseOrders   PurchaseOrder[]
}

// ─────────────────────────────── Inventory ───────────────────────────────

/// The stock ledger. Append-only. quantity/value are signed (+ in, - out).
model InventoryTransaction {
  id            String       @id @default(cuid())
  itemId        String
  movementType  MovementType
  quantity      Decimal      @db.Decimal(14, 3)
  unitCost      Decimal      @db.Decimal(18, 6)
  value         Decimal      @db.Decimal(16, 4)
  balanceBefore Decimal      @db.Decimal(14, 3)
  balanceAfter  Decimal      @db.Decimal(14, 3)
  valueBefore   Decimal      @db.Decimal(16, 4)
  valueAfter    Decimal      @db.Decimal(16, 4)
  sourceType    SourceType
  sourceId      String
  /// Line within the source document; together with sourceType/sourceId/movementType this is
  /// unique, so the same document line can never move stock twice.
  sourceLineId  String
  sourceRef     String
  batchNo       String?
  expiryDate    DateTime?
  txnDate       DateTime
  notes         String?
  createdById   String
  createdAt     DateTime     @default(now())

  item      Item @relation(fields: [itemId], references: [id])
  createdBy User @relation(fields: [createdById], references: [id])

  @@unique([sourceType, sourceId, sourceLineId, movementType])
  @@index([itemId, txnDate])
  @@index([movementType])
  @@index([txnDate])
  @@index([sourceType, sourceId])
}

/// Reconciled transactional cache of the ledger (one row per item).
model InventoryBalance {
  itemId            String   @id
  quantity          Decimal  @default(0) @db.Decimal(14, 3)
  value             Decimal  @default(0) @db.Decimal(16, 4)
  avgCost           Decimal  @default(0) @db.Decimal(18, 6)
  lastTransactionId String?
  updatedAt         DateTime @updatedAt
  item              Item     @relation(fields: [itemId], references: [id])
}

model StockAdjustment {
  id             String       @id @default(cuid())
  adjustmentNo   String       @unique
  itemId         String
  movementType   MovementType
  quantityChange Decimal      @db.Decimal(14, 3)
  reason         String
  createdById    String
  createdAt      DateTime     @default(now())
  item           Item         @relation(fields: [itemId], references: [id])
  createdBy      User         @relation(fields: [createdById], references: [id])
}

// ─────────────────────────────── Purchases ───────────────────────────────

model Purchase {
  id                String   @id @default(cuid())
  purchaseNo        String   @unique
  supplierId        String
  /// Optional purchase order this goods receipt was made against.
  purchaseOrderId   String?
  supplierInvoiceNo String
  invoiceDate       DateTime
  receivedDate      DateTime
  taxableTotal      Decimal  @db.Decimal(14, 2)
  taxTotal          Decimal  @db.Decimal(14, 2)
  grandTotal        Decimal  @db.Decimal(14, 2)
  notes             String?
  createdById       String
  createdAt         DateTime @default(now())

  supplier      Supplier         @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])
  createdBy     User             @relation(fields: [createdById], references: [id])
  items         PurchaseItem[]
  returns       PurchaseReturn[]

  @@unique([supplierId, supplierInvoiceNo])
  @@index([invoiceDate])
  @@index([purchaseOrderId])
}

model PurchaseItem {
  id                  String    @id @default(cuid())
  purchaseId          String
  itemId              String
  /// Quantity and rate as invoiced, in the purchase unit.
  quantity            Decimal   @db.Decimal(14, 3)
  unitId              String
  rate                Decimal   @db.Decimal(14, 4)
  /// Converted to the item's stock unit.
  stockQty            Decimal   @db.Decimal(14, 3)
  stockRate           Decimal   @db.Decimal(18, 6)
  taxableValue        Decimal   @db.Decimal(14, 2)
  gstRate             Decimal   @default(0) @db.Decimal(5, 2)
  taxAmount           Decimal   @default(0) @db.Decimal(14, 2)
  lineTotal           Decimal   @db.Decimal(14, 2)
  batchNo             String?
  expiryDate          DateTime?
  returnedQty         Decimal   @default(0) @db.Decimal(14, 3)
  /// PO line this receipt line fulfils (set when the purchase is received against a PO).
  purchaseOrderItemId String?

  purchase          Purchase           @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])
  item              Item               @relation(fields: [itemId], references: [id])
  unit              Unit               @relation(fields: [unitId], references: [id])
  returns           PurchaseReturn[]

  @@index([purchaseId])
  @@index([itemId])
}

model PurchaseReturn {
  id             String       @id @default(cuid())
  returnNo       String       @unique
  purchaseId     String
  purchaseItemId String
  quantity       Decimal      @db.Decimal(14, 3)
  value          Decimal      @db.Decimal(14, 2)
  reason         String
  createdById    String
  createdAt      DateTime     @default(now())
  purchase       Purchase     @relation(fields: [purchaseId], references: [id])
  purchaseItem   PurchaseItem @relation(fields: [purchaseItemId], references: [id])
  createdBy      User         @relation(fields: [createdById], references: [id])
}

/// Purchase order raised to a supplier before goods arrive. It never moves stock itself: stock only
/// changes when a goods receipt (Purchase) is posted against it, which also advances receivedQty.
model PurchaseOrder {
  id              String              @id @default(cuid())
  poNo            String              @unique
  supplierId      String
  orderDate       DateTime
  expectedDate    DateTime?
  status          PurchaseOrderStatus @default(OPEN)
  taxableTotal    Decimal             @db.Decimal(14, 2)
  taxTotal        Decimal             @db.Decimal(14, 2)
  grandTotal      Decimal             @db.Decimal(14, 2)
  notes           String?
  cancelledReason String?
  createdById     String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  createdBy User                @relation(fields: [createdById], references: [id])
  items     PurchaseOrderItem[]
  receipts  Purchase[]

  @@index([status])
  @@index([supplierId])
  @@index([orderDate])
}

model PurchaseOrderItem {
  id              String  @id @default(cuid())
  purchaseOrderId String
  itemId          String
  /// Ordered quantity and rate, in the PO unit.
  quantity        Decimal @db.Decimal(14, 3)
  unitId          String
  rate            Decimal @db.Decimal(14, 4)
  gstRate         Decimal @default(0) @db.Decimal(5, 2)
  taxableValue    Decimal @db.Decimal(14, 2)
  /// Received so far, in the PO unit. Updated only by goods-receipt postings.
  receivedQty     Decimal @default(0) @db.Decimal(14, 3)

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  item          Item           @relation(fields: [itemId], references: [id])
  unit          Unit           @relation(fields: [unitId], references: [id])
  receiptLines  PurchaseItem[]

  @@unique([purchaseOrderId, itemId])
}

// ─────────────────────────────── BOM ───────────────────────────────

model Bom {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  productId String
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  product   Product      @relation(fields: [productId], references: [id])
  versions  BomVersion[]

  @@index([productId])
}

/// Immutable once ACTIVE. Edits create a new version; production runs keep the version they used.
model BomVersion {
  id                   String    @id @default(cuid())
  bomId                String
  versionNo            Int
  status               BomStatus @default(DRAFT)
  /// Standard output per batch, in the product's unit (e.g. 200 packets).
  batchSize            Decimal   @db.Decimal(14, 3)
  /// Share of batch size expected as good output (100 = full batch).
  expectedYieldPct     Decimal   @default(100) @db.Decimal(5, 2)
  notes                String?
  /// Snapshot of material cost per batch at activation (weighted-average rates at that moment).
  standardMaterialCost Decimal?  @db.Decimal(14, 2)
  activatedAt          DateTime?
  archivedAt           DateTime?
  createdById          String
  createdAt            DateTime  @default(now())

  bom            Bom             @relation(fields: [bomId], references: [id])
  createdBy      User            @relation(fields: [createdById], references: [id])
  items          BomItem[]
  productionRuns ProductionRun[]

  @@unique([bomId, versionNo])
}

model BomItem {
  id           String     @id @default(cuid())
  bomVersionId String
  itemId       String
  quantity     Decimal    @db.Decimal(14, 4)
  unitId       String
  /// Weighted-average rate (per stock unit) captured when the version was activated.
  standardRate Decimal?   @db.Decimal(18, 6)
  sortOrder    Int        @default(0)
  notes        String?
  bomVersion   BomVersion @relation(fields: [bomVersionId], references: [id], onDelete: Cascade)
  item         Item       @relation(fields: [itemId], references: [id])
  unit         Unit       @relation(fields: [unitId], references: [id])

  @@unique([bomVersionId, itemId])
}

// ─────────────────────────────── Production ───────────────────────────────

model ProductionRun {
  id                   String           @id @default(cuid())
  runNo                String           @unique
  productId            String
  bomVersionId         String
  status               ProductionStatus @default(PLANNED)
  plannedBatches       Decimal          @db.Decimal(10, 3)
  plannedOutput        Decimal          @db.Decimal(14, 3)
  expectedOutput       Decimal          @db.Decimal(14, 3)
  actualGoodOutput     Decimal?         @db.Decimal(14, 3)
  scrapQty             Decimal?         @db.Decimal(14, 3)
  scrapNotes           String?
  batchNo              String?          @unique
  expiryDate           DateTime?
  plannedDate          DateTime
  startedAt            DateTime?
  completedAt          DateTime?
  notes                String?
  // Variance (snapshot at completion)
  actualYieldPct       Decimal?         @db.Decimal(8, 3)
  yieldVariancePct     Decimal?         @db.Decimal(8, 3)
  varianceTolerancePct Decimal?         @db.Decimal(5, 2)
  hasVarianceAlert     Boolean          @default(false)
  // Costing snapshot (material part frozen at completion; overhead part updated by allocations)
  materialCost         Decimal?         @db.Decimal(14, 2)
  packagingCost        Decimal?         @db.Decimal(14, 2)
  labourCost           Decimal          @default(0) @db.Decimal(14, 2)
  energyCost           Decimal          @default(0) @db.Decimal(14, 2)
  overheadCost         Decimal          @default(0) @db.Decimal(14, 2)
  totalCost            Decimal?         @db.Decimal(14, 2)
  costPerUnit          Decimal?         @db.Decimal(14, 4)
  sellingPrice         Decimal?         @db.Decimal(12, 2)
  grossMarginPerUnit   Decimal?         @db.Decimal(14, 4)
  marginPct            Decimal?         @db.Decimal(8, 3)
  createdById          String
  startedById          String?
  completedById        String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  product     Product              @relation(fields: [productId], references: [id])
  bomVersion  BomVersion           @relation(fields: [bomVersionId], references: [id])
  createdBy   User                 @relation("RunCreator", fields: [createdById], references: [id])
  materials   ProductionMaterial[]
  outputs     ProductionOutput[]
  allocations ExpenseAllocation[]
  expenses    Expense[]

  @@index([status])
  @@index([productId])
  @@index([completedAt])
}

model ProductionMaterial {
  id          String        @id @default(cuid())
  runId       String
  itemId      String
  /// Standard requirement for the planned batches, in the item's stock unit.
  plannedQty  Decimal       @db.Decimal(14, 3)
  /// Actual quantity used in good production (issued), stock unit.
  actualQty   Decimal?      @db.Decimal(14, 3)
  /// Damaged / wasted quantity (e.g. damaged pouches), stock unit. Deducted and costed.
  damagedQty  Decimal       @default(0) @db.Decimal(14, 3)
  unitCost    Decimal?      @db.Decimal(18, 6)
  totalCost   Decimal?      @db.Decimal(14, 2)
  variancePct Decimal?      @db.Decimal(8, 3)
  isFlagged   Boolean       @default(false)
  run         ProductionRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  item        Item          @relation(fields: [itemId], references: [id])

  @@unique([runId, itemId])
}

model ProductionOutput {
  id         String        @id @default(cuid())
  runId      String
  itemId     String
  quantity   Decimal       @db.Decimal(14, 3)
  batchNo    String
  expiryDate DateTime?
  unitCost   Decimal       @db.Decimal(18, 6)
  value      Decimal       @db.Decimal(14, 2)
  createdAt  DateTime      @default(now())
  run        ProductionRun @relation(fields: [runId], references: [id])
  item       Item          @relation(fields: [itemId], references: [id])

  @@unique([runId, itemId])
}

model Expense {
  id               String              @id @default(cuid())
  expenseNo        String              @unique
  expenseDate      DateTime
  category         ExpenseCategory
  amount           Decimal             @db.Decimal(14, 2)
  description      String
  allocationMethod AllocationMethod
  productionRunId  String?
  createdById      String
  createdAt        DateTime            @default(now())
  productionRun    ProductionRun?      @relation(fields: [productionRunId], references: [id])
  createdBy        User                @relation(fields: [createdById], references: [id])
  allocations      ExpenseAllocation[]

  @@index([expenseDate])
}

model ExpenseAllocation {
  id              String        @id @default(cuid())
  expenseId       String
  productionRunId String
  amount          Decimal       @db.Decimal(14, 2)
  basisQty        Decimal?      @db.Decimal(14, 3)
  createdAt       DateTime      @default(now())
  expense         Expense       @relation(fields: [expenseId], references: [id])
  productionRun   ProductionRun @relation(fields: [productionRunId], references: [id])

  @@unique([expenseId, productionRunId])
}

// ─────────────────────────────── Sales ───────────────────────────────

model SalesOrder {
  id              String      @id @default(cuid())
  orderNo         String      @unique
  /// Client-generated UUID; makes offline sync idempotent.
  clientRef       String      @unique
  customerId      String
  salesmanId      String
  orderDate       DateTime
  status          OrderStatus @default(PENDING)
  notes           String?
  subtotal        Decimal     @db.Decimal(14, 2)
  capturedOffline Boolean     @default(false)
  approvedById    String?
  approvedAt      DateTime?
  rejectedReason  String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  customer   Customer         @relation(fields: [customerId], references: [id])
  salesman   User             @relation("OrderSalesman", fields: [salesmanId], references: [id])
  approvedBy User?            @relation("OrderApprover", fields: [approvedById], references: [id])
  items      SalesOrderItem[]
  invoices   Invoice[]
  dispatches Dispatch[]

  @@index([status])
  @@index([salesmanId])
  @@index([customerId])
  @@index([orderDate])
}

model SalesOrderItem {
  id          String        @id @default(cuid())
  orderId     String
  productId   String
  quantity    Decimal       @db.Decimal(14, 3)
  rate        Decimal       @db.Decimal(12, 2)
  lineAmount  Decimal       @db.Decimal(14, 2)
  invoicedQty Decimal       @default(0) @db.Decimal(14, 3)
  order       SalesOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product       @relation(fields: [productId], references: [id])
  invoiceItem InvoiceItem[]

  @@unique([orderId, productId])
}

model Invoice {
  id                String        @id @default(cuid())
  invoiceNo         String        @unique
  financialYear     String
  sequence          Int
  orderId           String?
  customerId        String
  invoiceDate       DateTime
  dueDate           DateTime
  status            InvoiceStatus @default(ISSUED)
  supplyType        SupplyType
  placeOfSupply     String
  placeOfSupplyCode String        @db.VarChar(2)
  // Snapshots so a posted invoice never changes when masters change.
  customerName      String
  customerGstin     String?
  customerAddress   String
  sellerName        String
  sellerGstin       String
  sellerAddress     String
  sellerStateCode   String        @db.VarChar(2)
  taxableTotal      Decimal       @db.Decimal(14, 2)
  cgstTotal         Decimal       @db.Decimal(14, 2)
  sgstTotal         Decimal       @db.Decimal(14, 2)
  igstTotal         Decimal       @db.Decimal(14, 2)
  taxTotal          Decimal       @db.Decimal(14, 2)
  roundOff          Decimal       @db.Decimal(6, 2)
  grandTotal        Decimal       @db.Decimal(14, 2)
  notes             String?
  createdById       String
  cancelledAt       DateTime?
  createdAt         DateTime      @default(now())

  order       SalesOrder?         @relation(fields: [orderId], references: [id])
  customer    Customer            @relation(fields: [customerId], references: [id])
  createdBy   User                @relation("InvoiceCreator", fields: [createdById], references: [id])
  items       InvoiceItem[]
  dispatch    Dispatch?
  allocations PaymentAllocation[]
  creditNote  CreditNote?

  @@unique([financialYear, sequence])
  @@index([customerId])
  @@index([invoiceDate])
  @@index([status])
}

model InvoiceItem {
  id           String          @id @default(cuid())
  invoiceId    String
  productId    String
  orderItemId  String?
  description  String
  hsnCode      String
  unit         String
  quantity     Decimal         @db.Decimal(14, 3)
  rate         Decimal         @db.Decimal(12, 2)
  taxableValue Decimal         @db.Decimal(14, 2)
  gstRate      Decimal         @db.Decimal(5, 2)
  cgstRate     Decimal         @db.Decimal(5, 2)
  sgstRate     Decimal         @db.Decimal(5, 2)
  igstRate     Decimal         @db.Decimal(5, 2)
  cgstAmount   Decimal         @db.Decimal(14, 2)
  sgstAmount   Decimal         @db.Decimal(14, 2)
  igstAmount   Decimal         @db.Decimal(14, 2)
  lineTotal    Decimal         @db.Decimal(14, 2)
  invoice      Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  product      Product         @relation(fields: [productId], references: [id])
  orderItem    SalesOrderItem? @relation(fields: [orderItemId], references: [id])

  @@index([invoiceId])
  @@index([productId])
}

/// One dispatch per invoice (unique invoiceId) so finished goods are deducted exactly once.
model Dispatch {
  id           String         @id @default(cuid())
  dispatchNo   String         @unique
  invoiceId    String         @unique
  orderId      String?
  customerId   String
  dispatchDate DateTime
  vehicleNo    String?
  transporter  String?
  notes        String?
  createdById  String
  createdAt    DateTime       @default(now())
  invoice      Invoice        @relation(fields: [invoiceId], references: [id])
  order        SalesOrder?    @relation(fields: [orderId], references: [id])
  customer     Customer       @relation(fields: [customerId], references: [id])
  createdBy    User           @relation(fields: [createdById], references: [id])
  items        DispatchItem[]

  @@index([dispatchDate])
}

model DispatchItem {
  id         String   @id @default(cuid())
  dispatchId String
  productId  String
  quantity   Decimal  @db.Decimal(14, 3)
  unitCost   Decimal  @db.Decimal(18, 6)
  costValue  Decimal  @db.Decimal(14, 2)
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([dispatchId, productId])
}

/// Invoices are never deleted or edited; cancellation posts a credit note.
model CreditNote {
  id            String   @id @default(cuid())
  creditNoteNo  String   @unique
  invoiceId     String   @unique
  customerId    String
  noteDate      DateTime
  reason        String
  taxableTotal  Decimal  @db.Decimal(14, 2)
  cgstTotal     Decimal  @db.Decimal(14, 2)
  sgstTotal     Decimal  @db.Decimal(14, 2)
  igstTotal     Decimal  @db.Decimal(14, 2)
  grandTotal    Decimal  @db.Decimal(14, 2)
  stockReturned Boolean  @default(false)
  createdById   String
  createdAt     DateTime @default(now())
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
  customer      Customer @relation(fields: [customerId], references: [id])
  createdBy     User     @relation(fields: [createdById], references: [id])
}

model Payment {
  id          String              @id @default(cuid())
  receiptNo   String              @unique
  customerId  String
  paymentDate DateTime
  amount      Decimal             @db.Decimal(14, 2)
  mode        PaymentMode
  reference   String?
  notes       String?
  createdById String
  createdAt   DateTime            @default(now())
  customer    Customer            @relation(fields: [customerId], references: [id])
  createdBy   User                @relation(fields: [createdById], references: [id])
  allocations PaymentAllocation[]

  @@index([customerId])
  @@index([paymentDate])
}

model PaymentAllocation {
  id        String   @id @default(cuid())
  paymentId String
  invoiceId String
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id])
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}
